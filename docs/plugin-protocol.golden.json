{
  "about": [
    "Golden exchanges of the plugin protocol (docs/plugin-protocol.md). Both sides are tested",
    "against this one file: crates/cmd-core/tests/golden.rs and",
    "python/cmd-sdk/tests/unit/test_golden.py. Each exchange is a request the host sends, the",
    "answer a plugin sends, and what the host reads from that answer. Some answers hold what a",
    "newer or careless plugin might send and this SDK never would; sdk_never_sends names those",
    "items by id. A dropped entry is the start of the host's note about an item it left out.",
    "The events are lines a plugin starts, with no id, sent only to a host that names the",
    "tasks capability (task) or the notify capability (notify). Each holds the line, and what",
    "the host reads from it: a task or a notice (cleaned), an invalid line (the start of the",
    "host's note, with the line dropped), or other (a line",
    "that is not an event, which goes to the call in flight). sdk_never_sends marks a line the",
    "SDK refuses to write; the others the SDK writes as they are, up to key order."
  ],
  "exchanges": [
    {
      "name": "describe from a version 1 host, which names the tasks and notify capabilities",
      "request": {"id": 1, "method": "describe", "params": {"protocol": 1, "capabilities": ["tasks", "notify"]}},
      "answer": {"id": 1, "result": {"name": "golden", "version": "1.0.0", "protocol": 1, "keyword": "gold"}},
      "host_reads": {"description": {"name": "golden", "version": "1.0.0", "protocol": 1, "keyword": "gold"}}
    },
    {
      "name": "describe from a version 0 host, which sends no list of capabilities",
      "request": {"id": 1, "method": "describe", "params": {"protocol": 0}},
      "answer": {"id": 1, "result": {"name": "golden", "version": "1.0.0", "protocol": 0, "keyword": "gold"}},
      "host_reads": {"description": {"name": "golden", "version": "1.0.0", "protocol": 0, "keyword": "gold"}}
    },
    {
      "name": "describe from a plugin that wants the home query (blank input)",
      "request": {"id": 1, "method": "describe", "params": {"protocol": 1, "capabilities": ["tasks"]}},
      "answer": {"id": 1, "result": {"name": "golden", "version": "1.0.0", "protocol": 1, "home": true}},
      "host_reads": {"description": {"name": "golden", "version": "1.0.0", "protocol": 1, "home": true}}
    },
    {
      "name": "a query answered with items of every shape",
      "request": {"id": 2, "method": "query", "params": {"text": "safari"}},
      "answer": {"id": 2, "result": {"items": [
        {"id": "plain", "title": "Plain"},
        {"id": "app", "title": "Safari", "subtitle": "Application", "score": 0.75,
         "icon": {"kind": "path", "path": "/Applications/Safari.app"}},
        {"id": "search", "title": "Search the web", "score": 1,
         "actions": [{"id": "open", "title": "Open"}, {"id": "copy", "title": "Copy"}],
         "icon": {"kind": "symbol", "name": "globe"}},
        {"id": "sparkle", "title": "An icon of a kind this host does not know",
         "icon": {"kind": "emoji", "text": "*"}},
        {"id": "loud", "title": "A score above 1", "score": 7.5},
        {"id": "low", "title": "A score below 0", "score": -0.5},
        {"id": "untitled"},
        {"id": "numbered", "title": "A complete that is not text", "complete": 7},
        {"id": "hint", "title": "A suggestion", "complete": "gold more"},
        {"id": "hot", "title": "A scored suggestion", "score": 0.9, "complete": "gold hot"},
        {"id": "issue", "title": "A result that completes", "complete": "gold issue",
         "actions": [{"id": "open", "title": "Open"}]}
      ]}},
      "sdk_never_sends": ["sparkle", "untitled", "numbered"],
      "host_reads": {
        "items": [
          {"id": "plain", "title": "Plain"},
          {"id": "app", "title": "Safari", "subtitle": "Application", "score": 0.75,
           "icon": {"kind": "path", "path": "/Applications/Safari.app"}},
          {"id": "search", "title": "Search the web", "score": 1.0,
           "actions": [{"id": "open", "title": "Open"}, {"id": "copy", "title": "Copy"}],
           "icon": {"kind": "symbol", "name": "globe"}},
          {"id": "sparkle", "title": "An icon of a kind this host does not know"},
          {"id": "loud", "title": "A score above 1", "score": 1.0},
          {"id": "low", "title": "A score below 0", "score": 0.0},
          {"id": "hint", "title": "A suggestion", "complete": "gold more"},
          {"id": "hot", "title": "A scored suggestion", "score": 0.9, "complete": "gold hot"},
          {"id": "issue", "title": "A result that completes", "complete": "gold issue",
           "actions": [{"id": "open", "title": "Open"}]}
        ],
        "dropped": [
          "item 7 (\"untitled\"): missing field `title`",
          "item 8 (\"numbered\"): invalid type: integer `7`"
        ],
        "ranked": ["plain", "sparkle", "issue", "search", "loud", "hot", "app", "low", "hint"]
      }
    },
    {
      "name": "a run answered with an effect",
      "request": {"id": 3, "method": "run", "params": {"item": "search", "action": "open"}},
      "answer": {"id": 3, "result": {"effect": {"kind": "open", "target": "https://duckduckgo.com/?q=safari"}}},
      "host_reads": {"effect": {"kind": "open", "target": "https://duckduckgo.com/?q=safari"}}
    },
    {
      "name": "a query answered with an error",
      "request": {"id": 4, "method": "query", "params": {"text": "boom"}},
      "answer": {"id": 4, "error": {"code": "plugin_error", "message": "RuntimeError: boom"}},
      "host_reads": {"error": {"code": "plugin_error", "message": "RuntimeError: boom"}}
    },
    {
      "name": "the home query, answered with the rows blank input shows",
      "request": {"id": 5, "method": "query", "params": {"text": "", "home": true}},
      "answer": {"id": 5, "result": {"items": [
        {"id": "moved", "title": "Ticket 7 moved to Done", "actions": [{"id": "open", "title": "Open"}]},
        {"id": "watching", "title": "Watching 3 tickets", "complete": "gold watching"}
      ]}},
      "host_reads": {
        "items": [
          {"id": "moved", "title": "Ticket 7 moved to Done", "actions": [{"id": "open", "title": "Open"}]},
          {"id": "watching", "title": "Watching 3 tickets", "complete": "gold watching"}
        ],
        "dropped": [],
        "ranked": ["moved", "watching"]
      }
    }
  ],
  "events": [
    {
      "name": "a running task with progress and a detail",
      "line": {"event": "task", "params": {"id": "index", "label": "Indexing notes", "state": "running", "done": 120, "total": 900, "detail": "meetings/2026"}},
      "host_reads": {"task": {"id": "index", "label": "Indexing notes", "state": "running", "done": 120, "total": 900, "detail": "meetings/2026"}}
    },
    {
      "name": "a task with no progress, done",
      "line": {"event": "task", "params": {"id": "outbox", "label": "Saving to the vault", "state": "done"}},
      "host_reads": {"task": {"id": "outbox", "label": "Saving to the vault", "state": "done"}}
    },
    {
      "name": "a failed task says why",
      "line": {"event": "task", "params": {"id": "outbox", "label": "Saving to the vault", "state": "failed", "detail": "Obsidian is not running"}},
      "host_reads": {"task": {"id": "outbox", "label": "Saving to the vault", "state": "failed", "detail": "Obsidian is not running"}}
    },
    {
      "name": "text is cleaned of control characters and cut at 160 characters",
      "line": {"event": "task", "params": {"id": "index", "label": "Index\u0007ing\nnotes", "state": "running", "detail": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"}},
      "host_reads": {"task": {"id": "index", "label": "Indexing notes", "state": "running", "detail": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"}}
    },
    {
      "name": "a task without a label is dropped and noted",
      "line": {"event": "task", "params": {"id": "index", "state": "running"}},
      "sdk_never_sends": true,
      "host_reads": {"invalid": "label is required"}
    },
    {
      "name": "a task with done above total is dropped and noted",
      "line": {"event": "task", "params": {"id": "index", "label": "Indexing", "state": "running", "done": 901, "total": 900}},
      "sdk_never_sends": true,
      "host_reads": {"invalid": "done (901) is more than total (900)"}
    },
    {
      "name": "a task in a state the host does not know is dropped and noted",
      "line": {"event": "task", "params": {"id": "index", "label": "Indexing", "state": "paused"}},
      "sdk_never_sends": true,
      "host_reads": {"invalid": "state must be running, done or failed"}
    },
    {
      "name": "a notice with a body and a target to open",
      "line": {"event": "notify", "params": {"id": "PROJ-12", "title": "PROJ-12 moved", "body": "In Review", "open": "https://example.test/PROJ-12"}},
      "host_reads": {"notice": {"id": "PROJ-12", "title": "PROJ-12 moved", "body": "In Review", "open": "https://example.test/PROJ-12"}}
    },
    {
      "name": "a notice with only an id and a title",
      "line": {"event": "notify", "params": {"id": "build", "title": "The build finished"}},
      "host_reads": {"notice": {"id": "build", "title": "The build finished"}}
    },
    {
      "name": "a notice's text is cleaned and cut at 160 characters, its target is kept whole",
      "line": {"event": "notify", "params": {"id": "PROJ-13", "title": "Moved\u0007\nnow", "body": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "open": "file:///Users/me/notes/PROJ-13.md"}},
      "host_reads": {"notice": {"id": "PROJ-13", "title": "Moved now", "body": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "open": "file:///Users/me/notes/PROJ-13.md"}}
    },
    {
      "name": "a notice without a title is dropped and noted",
      "line": {"event": "notify", "params": {"id": "PROJ-12"}},
      "sdk_never_sends": true,
      "host_reads": {"invalid": "title is required"}
    },
    {
      "name": "a notice with an empty target is dropped and noted",
      "line": {"event": "notify", "params": {"id": "PROJ-12", "title": "Moved", "open": ""}},
      "sdk_never_sends": true,
      "host_reads": {"invalid": "open must not be empty"}
    },
    {
      "name": "a line with a notify event and an id is not an event",
      "line": {"id": 4, "event": "notify", "params": {}},
      "sdk_never_sends": true,
      "host_reads": {"other": true}
    },
    {
      "name": "an event of another name is dropped and noted",
      "line": {"event": "spinner", "params": {}},
      "sdk_never_sends": true,
      "host_reads": {"invalid": "unknown event"}
    },
    {
      "name": "an answer is not an event",
      "line": {"id": 2, "result": {"items": []}},
      "sdk_never_sends": true,
      "host_reads": {"other": true}
    },
    {
      "name": "a line with an event and an id is not an event",
      "line": {"id": 3, "event": "task", "params": {}},
      "sdk_never_sends": true,
      "host_reads": {"other": true}
    }
  ]
}
