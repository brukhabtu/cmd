// Intra-system relationships for cmd, plus the person and external edges that
// land on its containers and components. Explicit endpoints only.
model {
  extend cmd {
    user -> app 'types a query into and picks a result from'
    author -> plugin.code 'writes and installs'

    app.ui -> app.core 'applies events to and performs the steps returned by'
    app.ui -> app.host 'asks for results and runs actions through'
    app.host -> app.core 'routes queries, checks protocol versions, and encodes and decodes protocol lines with'

    app.host -> plugin.sdk 'sends describe, query and run requests to' {
      technology 'JSON lines over stdin and stdout'
    }
    plugin.code -> plugin.sdk 'describes itself to, and hands its query and run functions to'

    app.ui -> macos 'reads and writes the pasteboard, takes typed and composed text from the input method, opens targets and hides the window through' {
      technology 'AppKit via GPUI'
    }
    plugin.code -> macos 'reads from and acts on, as its author chooses' {
      technology 'whatever the plugin calls'
    }
  }
}
